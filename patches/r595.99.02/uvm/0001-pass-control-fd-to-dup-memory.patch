 EXPORT_SYMBOL(nvUvmInterfaceDupMemory);
+
+/* The ordinary single-RM implementation needs no cross-provider
+ * owner routing. A hybrid frontend replaces this public dispatcher
+ * and resolves the source handles through rmControlFd.
+ */
+NV_STATUS nvUvmInterfaceDupMemoryWithControlFd(int rmControlFd,
+                                               uvmGpuDeviceHandle device,
+                                               NvHandle hClient,
+                                               NvHandle hPhysMemory,
+                                               NvHandle *hDupMemory,
+                                               UvmGpuMemoryInfo *pGpuMemoryInfo)
+{
+    (void)rmControlFd;
+    return nvUvmInterfaceDupMemory(device, hClient, hPhysMemory,
+                                   hDupMemory, pGpuMemoryInfo);
+}
+EXPORT_SYMBOL(nvUvmInterfaceDupMemoryWithControlFd);
 
 
