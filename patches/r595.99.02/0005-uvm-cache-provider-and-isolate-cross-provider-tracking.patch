+// Inspect only live entries. These helpers are safe in tracker-protected
+// regions: provider identity is immutable and requires no RM/bridge callback.
+bool uvm_tracker_has_other_gpus(uvm_tracker_t *tracker, uvm_gpu_t *gpu)
+{
+    uvm_tracker_entry_t *entry;
+
+    for_each_tracker_entry(entry, tracker) {
+        if (uvm_tracker_is_entry_completed(entry))
+            continue;
+        if (uvm_tracker_entry_gpu(entry) != gpu)
+            return true;
+    }
+
+    return false;
+}
+
+bool uvm_tracker_has_other_providers(uvm_tracker_t *tracker, uvm_gpu_t *gpu)
+{
+    uvm_tracker_entry_t *entry;
+
+    for_each_tracker_entry(entry, tracker) {
+        uvm_gpu_t *entry_gpu;
+
+        if (uvm_tracker_is_entry_completed(entry))
+            continue;
+
+        entry_gpu = uvm_tracker_entry_gpu(entry);
+        if (entry_gpu == gpu)
+            continue;
+
+        if (gpu->hybrid_provider_id == 0 || entry_gpu->hybrid_provider_id == 0 ||
+            gpu->hybrid_provider_id != entry_gpu->hybrid_provider_id)
+            return true;
+    }
+
+    return false;
+}
