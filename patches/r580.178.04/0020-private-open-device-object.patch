+NV_STATUS hybrid580_open_control_session_device_alloc_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_device, const NV0080_ALLOC_PARAMETERS *params,
+    NvHandle *returned_device, NvU32 *rm_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV0080_ALLOC_PARAMETERS alloc_params;
+    NVOS64_PARAMETERS alloc;
+    nvidia_stack_t *sp = NULL;
+    nvidia_kernel_rmapi_ops_t ops;
+    NV_STATUS status;
+    int rc;
+
+    if (rm_status == NULL || returned_device == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *rm_status = 0xffffffffU;
+    *returned_device = 0;
+    if (session == NULL || params == NULL || h_root == 0 || h_device == 0 ||
+        params->deviceId >= NV_MAX_DEVICES ||
+        (params->hClientShare != 0 && params->hClientShare != h_root) ||
+        params->hTargetClient != 0 || params->hTargetDevice != 0)
+    {
+        *rm_status = NV_ERR_INVALID_ARGUMENT;
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    alloc_params = *params;
+    alloc = (NVOS64_PARAMETERS) {
+        .hRoot = h_root,
+        .hObjectParent = h_root,
+        .hObjectNew = h_device,
+        .hClass = NV01_DEVICE_0,
+        .pAllocParms = NV_PTR_TO_NvP64(&alloc_params),
+        .pRightsRequested = NvP64_NULL,
+        .paramsSize = sizeof(*params),
+        .flags = NVOS64_FLAGS_NONE,
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_open_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    if (nv_kmem_cache_alloc_stack(&sp) != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        ops = (nvidia_kernel_rmapi_ops_t) { .op = NV04_ALLOC, .params.alloc = alloc };
+        rm_kernel_rmapi_op(sp, &ops);
+        alloc = ops.params.alloc;
+        *rm_status = alloc.status;
+        *returned_device = alloc.hObjectNew;
+    }
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_open_control_session_device_alloc_v1);
+
+
+NV_STATUS hybrid580_open_control_session_device_free_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_device, NvU32 *rm_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NVOS00_PARAMETERS packet;
+    nvidia_stack_t *sp = NULL;
+    nvidia_kernel_rmapi_ops_t ops;
+    NV_STATUS status;
+    int rc;
+
+    if (rm_status == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *rm_status = 0xffffffffU;
+    if (session == NULL || h_root == 0 || h_device == 0 || h_device == h_root)
+    {
+        *rm_status = NV_ERR_INVALID_ARGUMENT;
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+    packet = (NVOS00_PARAMETERS) {
+        .hRoot = h_root,
+        .hObjectParent = h_root,
+        .hObjectOld = h_device,
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_open_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    if (nv_kmem_cache_alloc_stack(&sp) != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        ops = (nvidia_kernel_rmapi_ops_t) { .op = NV01_FREE, .params.free = packet };
+        rm_kernel_rmapi_op(sp, &ops);
+        packet = ops.params.free;
+        *rm_status = packet.status;
+    }
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_open_control_session_device_free_v1);
