+// Return whether requested pages would require an unsupported GPU -> CPU
+// staging copy in isolated mode. The caller supplies the already-filtered
+// page mask and a scratch mask which this helper may overwrite.
+static bool block_has_unsupported_isolated_staging(uvm_va_block_t *block,
+                                                    uvm_va_block_context_t *block_context,
+                                                    uvm_processor_id_t dst_id,
+                                                    uvm_va_block_region_t region,
+                                                    const uvm_page_mask_t *copy_page_mask)
+{
+    uvm_processor_id_t src_id;
+    uvm_page_mask_t *source_pages_mask = &block_context->make_resident.copy_resident_pages_mask;
+    const uvm_processor_mask_t *can_copy_from = block_get_can_copy_from_mask(block, dst_id);
+
+    for_each_gpu_id_in_mask(src_id, &block->resident) {
+        if (uvm_id_equal(src_id, dst_id) || uvm_processor_mask_test(can_copy_from, src_id))
+            continue;
+
+        uvm_page_mask_and(source_pages_mask,
+                          copy_page_mask,
+                          uvm_va_block_resident_mask_get(block, src_id, NUMA_NO_NODE));
+        uvm_page_mask_region_clear_outside(source_pages_mask, region);
+        if (!uvm_page_mask_empty(source_pages_mask))
+            return true;
+    }
+
+    return false;
+}
