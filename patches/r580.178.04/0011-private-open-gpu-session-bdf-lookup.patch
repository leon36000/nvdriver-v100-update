+int hybrid580_open_gpu_session_create_by_bdf_v1(
+    struct file *anchor, const char *expected_bdf,
+    struct hybrid580_gpu_session **out)
+{
+    nv_linux_state_t *nvl;
+    NvU32 minor;
+
+    if (out == NULL)
+        return -EINVAL;
+    *out = NULL;
+    if (!hybrid580_open_gpu_bdf_valid(expected_bdf))
+        return -EINVAL;
+
+    LOCK_NV_LINUX_DEVICES();
+    for (minor = 0; minor <= NV_MINOR_DEVICE_NUMBER_REGULAR_MAX; ++minor)
+    {
+        nvl = find_minor_locked(minor);
+        if (nvl != NULL && nvl != &nv_ctl_device && nvl->pci_dev != NULL &&
+            hybrid580_open_gpu_bdf_matches(expected_bdf, pci_name(nvl->pci_dev)))
+            break;
+    }
+    UNLOCK_NV_LINUX_DEVICES();
+    if (minor > NV_MINOR_DEVICE_NUMBER_REGULAR_MAX)
+        return -EXDEV;
+
+    /* The minor may be reused after the scan. create_v1 rechecks the BDF
+     * before and after nvidia_open(), so only the requested GPU is published.
+     */
+    return hybrid580_open_gpu_session_create_v1(anchor, minor, expected_bdf, out);
+}
+EXPORT_SYMBOL(hybrid580_open_gpu_session_create_by_bdf_v1);
