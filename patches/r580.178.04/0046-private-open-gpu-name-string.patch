--- a/kernel-open/nvidia/nv.c
+++ b/kernel-open/nvidia/nv.c
@@ -4917,6 +4917,97 @@
 EXPORT_SYMBOL(hybrid580_open_control_session_fabric_status_v1);
 
 
+/* Execute only the fixed, pointer-free R580 NV20_SUBDEVICE_0 name query. */
+NV_STATUS hybrid580_open_control_session_gpu_name_string_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_subdevice, NvU32 flags,
+    NV2080_CTRL_GPU_GET_NAME_STRING_PARAMS *params,
+    NvU32 *control_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV2080_CTRL_GPU_GET_NAME_STRING_PARAMS result;
+    NVOS54_PARAMETERS control;
+    nvidia_stack_t *sp = NULL;
+    nvidia_kernel_rmapi_ops_t ops;
+    NV_STATUS status;
+    int rc;
+
+    if (control_status == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *control_status = 0xffffffffU;
+    if (session == NULL || params == NULL || h_root == 0 || h_subdevice == 0 ||
+        flags != NVOS54_FLAGS_NONE ||
+        (params->gpuNameStringFlags !=
+             NV2080_CTRL_GPU_GET_NAME_STRING_FLAGS_TYPE_ASCII &&
+         params->gpuNameStringFlags !=
+             NV2080_CTRL_GPU_GET_NAME_STRING_FLAGS_TYPE_UNICODE))
+        return NV_ERR_INVALID_ARGUMENT;
+
+    result = *params;
+    memset(&result.gpuNameString, 0, sizeof(result.gpuNameString));
+    control = (NVOS54_PARAMETERS) {
+        .hClient = h_root,
+        .hObject = h_subdevice,
+        .cmd = NV2080_CTRL_CMD_GPU_GET_NAME_STRING,
+        .flags = flags,
+        .params = KERNEL_POINTER_TO_NvP64(&result),
+        .paramsSize = sizeof(result),
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_open_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status != NV_OK)
+        goto done_pm;
+    rc = nv_kmem_cache_alloc_stack(&sp);
+    if (rc != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+
+    ops = (nvidia_kernel_rmapi_ops_t) {
+        .op = NV04_CONTROL,
+        .params.control = control,
+    };
+    rm_kernel_rmapi_op(sp, &ops);
+    control = ops.params.control;
+    if (control.status == 0xffffffffU)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done_pm;
+    }
+    *control_status = (NvU32)control.status;
+    if (control.status == NV_OK)
+        *params = result;
+    status = NV_OK;
+
+done_pm:
+    if (sp != NULL)
+        nv_kmem_cache_free_stack(sp);
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_open_control_session_gpu_name_string_v1);
+
+
