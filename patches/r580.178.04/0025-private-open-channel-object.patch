 EXPORT_SYMBOL(hybrid580_open_control_session_context_share_alloc_v1);
 
 
+NV_STATUS hybrid580_open_control_session_channel_alloc_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_group, NvHandle h_channel, NvU32 class_id,
+    NV_CHANNEL_ALLOC_PARAMS *params, NvHandle *returned_channel,
+    NvU32 *rm_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV_CHANNEL_ALLOC_PARAMS alloc_params;
+    NVOS64_PARAMETERS alloc;
+    nvidia_stack_t *sp = NULL;
+    nvidia_kernel_rmapi_ops_t ops;
+    NV_STATUS status;
+    int rc;
+
+    if (rm_status == NULL || returned_channel == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *rm_status = 0xffffffffU;
+    *returned_channel = 0;
+    if (class_id != BLACKWELL_CHANNEL_GPFIFO_A)
+    {
+        *rm_status = NV_ERR_INVALID_CLASS;
+        return NV_ERR_INVALID_CLASS;
+    }
+    if (session == NULL || params == NULL || h_root == 0 || h_group == 0 ||
+        h_channel == 0 || h_channel == h_root || h_channel == h_group ||
+        params->hVASpace != 0 || params->hObjectEccError != 0 ||
+        params->hPhysChannelGroup != 0 || params->internalFlags != 0 ||
+        (params->flags & 0x3U) != NVOS04_FLAGS_CHANNEL_TYPE_PHYSICAL)
+    {
+        *rm_status = NV_ERR_INVALID_ARGUMENT;
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    alloc_params = *params;
+    alloc = (NVOS64_PARAMETERS) {
+        .hRoot = h_root,
+        .hObjectParent = h_group,
+        .hObjectNew = h_channel,
+        .hClass = class_id,
+        .pAllocParms = NV_PTR_TO_NvP64(&alloc_params),
+        .pRightsRequested = NvP64_NULL,
+        .paramsSize = sizeof(alloc_params),
+        .flags = NVOS64_FLAGS_NONE,
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_open_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    if (nv_kmem_cache_alloc_stack(&sp) != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        ops = (nvidia_kernel_rmapi_ops_t) {
+            .op = NV04_ALLOC,
+            .params.alloc = alloc,
+        };
+        rm_kernel_rmapi_op(sp, &ops);
+        alloc = ops.params.alloc;
+        *params = alloc_params;
+        *rm_status = alloc.status;
+        *returned_channel = alloc.hObjectNew;
+    }
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_open_control_session_channel_alloc_v1);
+
