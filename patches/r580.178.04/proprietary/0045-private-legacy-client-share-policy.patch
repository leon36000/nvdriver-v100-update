--- a/nvidia/nv.c
+++ b/nvidia/nv.c
@@ -6323,6 +6323,101 @@
 EXPORT_SYMBOL(hybrid580_legacy_control_session_gpu_name_string_v1);
 
 
+/* Apply the fixed, input-only R580/R595 root-client share policy. The public
+ * ctrl0000client.h packet is exactly one 12-byte RS_SHARE_POLICY. */
+NV_STATUS hybrid580_legacy_control_session_client_share_policy_v1(
+    struct hybrid580_control_session *session, NvHandle h_client,
+    NvHandle h_object, NvU32 flags, RS_SHARE_POLICY *policy,
+    NvU32 *control_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_linux_state_t *nvl;
+    nv_state_t *nv;
+    struct { RS_SHARE_POLICY sharePolicy; } result;
+    NVOS54_PARAMETERS control;
+    nvidia_stack_t *sp = NULL;
+    nvidia_kernel_rmapi_ops_t ops;
+    NV_STATUS status;
+    int rc;
+
+    if (control_status == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *control_status = 0xffffffffU;
+    if (session == NULL || policy == NULL || h_client == 0 ||
+        h_client != h_object || flags != NVOS54_FLAGS_NONE)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    result.sharePolicy = *policy;
+    BUILD_BUG_ON(sizeof(result) != 12);
+    control = (NVOS54_PARAMETERS) {
+        .hClient = h_client,
+        .hObject = h_object,
+        .cmd = 0x00000d04U, /* NV0000_CTRL_CMD_CLIENT_SET_INHERITED_SHARE_POLICY */
+        .flags = flags,
+        .params = KERNEL_POINTER_TO_NvP64(&result),
+        .paramsSize = sizeof(result),
+        .status = 0xffffffffU,
+    };
+
+    rc = mutex_lock_interruptible(&session->lock);
+    if (rc != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL || nvlfp->nvptr != &nv_ctl_device)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    nvl = nvlfp->nvptr;
+    nv = NV_STATE_PTR(nvl);
+    if ((nv->flags & NV_FLAG_CONTROL) == 0)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    status = nv_check_gpu_state(nv);
+    if (status != NV_OK)
+        goto done_pm;
+    rc = nv_kmem_cache_alloc_stack(&sp);
+    if (rc != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+
+    ops = (nvidia_kernel_rmapi_ops_t) {
+        .op = NV04_CONTROL,
+        .params.control = control,
+    };
+    rm_kernel_rmapi_op(sp, &ops);
+    control = ops.params.control;
+    if (control.status == 0xffffffffU)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done_pm;
+    }
+    *control_status = (NvU32)control.status;
+    status = NV_OK;
+
+done_pm:
+    if (sp != NULL)
+        nv_kmem_cache_free_stack(sp);
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_client_share_policy_v1);
+
+
 NV_STATUS hybrid580_legacy_control_session_engine_alloc_v1(
