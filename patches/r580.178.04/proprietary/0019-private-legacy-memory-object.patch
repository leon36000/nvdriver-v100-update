+NV_STATUS hybrid580_legacy_control_session_memory_alloc_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_parent, NvHandle h_object, NvU32 class_id,
+    NV_MEMORY_ALLOCATION_PARAMS *params, NvHandle *returned_object,
+    NvU32 *rm_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV_MEMORY_ALLOCATION_PARAMS alloc_params;
+    NVOS64_PARAMETERS alloc;
+    nvidia_stack_t *sp = NULL;
+    NV_STATUS status;
+    int rc;
+
+    if (rm_status == NULL || returned_object == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *rm_status = 0xffffffffU;
+    *returned_object = 0;
+    if (session == NULL || params == NULL || h_root == 0 || h_parent == 0 ||
+        h_object == 0 || h_object == h_root || h_object == h_parent ||
+        (class_id != NV01_MEMORY_SYSTEM &&
+         class_id != NV01_MEMORY_LOCAL_USER &&
+         class_id != 0x000050a0U /* NV50_MEMORY_VIRTUAL */))
+    {
+        *rm_status = NV_ERR_INVALID_ARGUMENT;
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+    alloc_params = *params;
+    alloc = (NVOS64_PARAMETERS) {
+        .hRoot = h_root,
+        .hObjectParent = h_parent,
+        .hObjectNew = h_object,
+        .hClass = class_id,
+        .pAllocParms = NV_PTR_TO_NvP64(&alloc_params),
+        .pRightsRequested = NvP64_NULL,
+        .paramsSize = sizeof(alloc_params),
+        .flags = NVOS64_FLAGS_NONE,
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    if (nv_kmem_cache_alloc_stack(&sp) != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        status = rm_ioctl(sp, nv, &nvlfp->nvfp, NV_ESC_RM_ALLOC,
+                          &alloc, sizeof(alloc));
+        *params = alloc_params;
+        *rm_status = alloc.status;
+        *returned_object = alloc.hObjectNew;
+    }
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_memory_alloc_v1);
+
+
+NV_STATUS hybrid580_legacy_control_session_object_free_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_parent, NvHandle h_object, NvU32 *rm_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NVOS00_PARAMETERS packet;
+    nvidia_stack_t *sp = NULL;
+    NV_STATUS status;
+    int rc;
+
+    if (rm_status == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *rm_status = 0xffffffffU;
+    if (session == NULL || h_root == 0 || h_parent == 0 || h_object == 0 ||
+        h_object == h_root || h_object == h_parent)
+    {
+        *rm_status = NV_ERR_INVALID_ARGUMENT;
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+    packet = (NVOS00_PARAMETERS) {
+        .hRoot = h_root,
+        .hObjectParent = h_parent,
+        .hObjectOld = h_object,
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    if (nv_kmem_cache_alloc_stack(&sp) != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        status = rm_ioctl(sp, nv, &nvlfp->nvfp, NV_ESC_RM_FREE,
+                          &packet, sizeof(packet));
+        *rm_status = packet.status;
+    }
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_object_free_v1);
