+int hybrid580_legacy_control_session_attach_v1(
+    struct hybrid580_control_session *session, const NvU32 *gpu_ids,
+    NvU32 count)
+{
+    nv_linux_file_private_t *nvlfp;
+    nvidia_stack_t *sp = NULL;
+    nv_state_t *nv;
+    size_t arg_size;
+    int rc;
+
+    if (session == NULL || gpu_ids == NULL || count == 0 ||
+        count > NV_ABSOLUTE_MAX_IOCTL_SIZE / sizeof(NvU32))
+        return -EINVAL;
+    arg_size = (size_t)count * sizeof(NvU32);
+    rc = mutex_lock_interruptible(&session->lock);
+    if (rc != 0)
+        return rc;
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        rc = -EINVAL;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+        goto done;
+    rc = nv_kmem_cache_alloc_stack(&sp);
+    if (rc != 0)
+        goto done_pm;
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    if (nv_check_gpu_state(nv) != NV_OK)
+        rc = -EINVAL;
+    else
+        rc = hybrid580_attach_gpus_to_file(nvlfp, sp, gpu_ids, arg_size);
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return rc;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_attach_v1);
 
