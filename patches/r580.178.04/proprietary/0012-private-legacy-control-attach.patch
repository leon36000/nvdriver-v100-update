 /* An unpublished control file has ordinary vendor private storage. The owner
  * holds a session reference throughout every call and mapping publication.
  * This mutex serializes calls only; it never covers a final fput(). */
+/* Kernel-owned equivalent of the NV_ESC_ATTACH_GPUS_TO_FD wrapper path.
+ * This shares the exact pin/rollback rules with nvidia_ioctl while avoiding
+ * copy_from_user for private control sessions. Caller holds PM read lock and
+ * a live NVIDIA stack.
+ */
+static int hybrid580_attach_gpus_to_file(
+    nv_linux_file_private_t *nvlfp, nvidia_stack_t *sp,
+    const NvU32 *gpu_ids, size_t arg_size)
+{
+    nv_linux_state_t *nvl;
+    size_t num_arg_gpus, i;
+
+    if (nvlfp == NULL || sp == NULL || gpu_ids == NULL || arg_size == 0 ||
+        arg_size > NV_ABSOLUTE_MAX_IOCTL_SIZE || arg_size % sizeof(NvU32) != 0)
+        return -EINVAL;
+    nvl = nvlfp->nvptr;
+    if (nvl == NULL)
+        return -EINVAL;
+    num_arg_gpus = arg_size / sizeof(NvU32);
+
+    /* Keep the vendor's check-and-publish protocol on the control file. */
+    down(&nvl->ldata_lock);
+    if (nvlfp->num_attached_gpus != 0)
+    {
+        up(&nvl->ldata_lock);
+        return -EINVAL;
+    }
+    NV_KMALLOC(nvlfp->attached_gpus, arg_size);
+    if (nvlfp->attached_gpus == NULL)
+    {
+        up(&nvl->ldata_lock);
+        return -ENOMEM;
+    }
+    memcpy(nvlfp->attached_gpus, gpu_ids, arg_size);
+    nvlfp->num_attached_gpus = num_arg_gpus;
+    up(&nvl->ldata_lock);
+
+    for (i = 0; i < num_arg_gpus; ++i)
+    {
+        if (nvlfp->attached_gpus[i] == 0)
+            continue;
+        if (nvidia_dev_get(nvlfp->attached_gpus[i], sp))
+        {
+            while (i--)
+            {
+                if (nvlfp->attached_gpus[i] != 0)
+                    nvidia_dev_put(nvlfp->attached_gpus[i], sp);
+            }
+            down(&nvl->ldata_lock);
+            NV_KFREE(nvlfp->attached_gpus, arg_size);
+            nvlfp->num_attached_gpus = 0;
+            up(&nvl->ldata_lock);
+            return -EINVAL;
+        }
+    }
+    return 0;
+}
