 EXPORT_SYMBOL(hybrid580_legacy_control_session_gr_tpc_mask_v1);
 
 
+NV_STATUS hybrid580_legacy_control_session_binapi_alloc_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_subdevice, NvHandle h_binapi,
+    const NV2081_ALLOC_PARAMETERS *params, NvHandle *returned_binapi,
+    NvU32 *rm_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV2081_ALLOC_PARAMETERS alloc_params;
+    NVOS64_PARAMETERS alloc;
+    nvidia_stack_t *sp = NULL;
+    NV_STATUS status;
+    int rc;
+
+    if (rm_status == NULL || returned_binapi == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *rm_status = 0xffffffffU;
+    *returned_binapi = 0;
+    if (session == NULL || params == NULL || h_root == 0 || h_subdevice == 0 ||
+        h_binapi == 0 || h_binapi == h_root || h_binapi == h_subdevice ||
+        params->reserved != 0)
+    {
+        *rm_status = NV_ERR_INVALID_ARGUMENT;
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    alloc_params = *params;
+    alloc = (NVOS64_PARAMETERS) {
+        .hRoot = h_root,
+        .hObjectParent = h_subdevice,
+        .hObjectNew = h_binapi,
+        .hClass = NV2081_BINAPI,
+        .pAllocParms = NV_PTR_TO_NvP64(&alloc_params),
+        .pRightsRequested = NvP64_NULL,
+        .paramsSize = sizeof(alloc_params),
+        .flags = NVOS64_FLAGS_NONE,
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    if (nv_kmem_cache_alloc_stack(&sp) != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        status = rm_ioctl(sp, nv, &nvlfp->nvfp, NV_ESC_RM_ALLOC,
+                          &alloc, sizeof(alloc));
+        if (status == NV_OK)
+        {
+            *rm_status = alloc.status;
+            *returned_binapi = alloc.hObjectNew;
+        }
+    }
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_binapi_alloc_v1);
