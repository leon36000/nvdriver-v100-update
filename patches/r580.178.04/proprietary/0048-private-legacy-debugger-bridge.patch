+NV_STATUS hybrid580_legacy_control_session_debugger_alloc_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_parent, NvHandle h_debugger,
+    const NV83DE_ALLOC_PARAMETERS *params,
+    NvHandle *returned_debugger, NvU32 *rm_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV83DE_ALLOC_PARAMETERS alloc_params;
+    NVOS64_PARAMETERS alloc;
+    nvidia_stack_t *sp = NULL;
+    nvidia_kernel_rmapi_ops_t ops;
+    NV_STATUS status;
+    int rc;
+
+    if (rm_status == NULL || returned_debugger == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *rm_status = 0xffffffffU;
+    *returned_debugger = 0;
+    if (session == NULL || params == NULL || h_root == 0 || h_parent == 0 ||
+        h_debugger == 0 || h_debugger == h_root || h_debugger == h_parent ||
+        params->hDebuggerClient_Obsolete != 0 ||
+        params->hAppClient != h_root || params->hClass3dObject == 0)
+    {
+        *rm_status = NV_ERR_INVALID_ARGUMENT;
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    alloc_params = *params;
+    BUILD_BUG_ON(sizeof(alloc_params) != 12);
+    alloc = (NVOS64_PARAMETERS) {
+        .hRoot = h_root,
+        .hObjectParent = h_parent,
+        .hObjectNew = h_debugger,
+        .hClass = GT200_DEBUGGER,
+        .pAllocParms = KERNEL_POINTER_TO_NvP64(&alloc_params),
+        .pRightsRequested = NvP64_NULL,
+        .paramsSize = sizeof(alloc_params),
+        .flags = NVOS64_FLAGS_NONE,
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    if (nv_kmem_cache_alloc_stack(&sp) != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        ops = (nvidia_kernel_rmapi_ops_t) {
+            .op = NV04_ALLOC,
+            .params.alloc = alloc,
+        };
+        rm_kernel_rmapi_op(sp, &ops);
+        alloc = ops.params.alloc;
+        *rm_status = alloc.status;
+        *returned_debugger = alloc.hObjectNew;
+    }
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_debugger_alloc_v1);
+
+NV_STATUS hybrid580_legacy_control_session_debugger_exception_mask_v1(
+    struct hybrid580_control_session *session, NvHandle h_client,
+    NvHandle h_debugger,
+    NV83DE_CTRL_DEBUG_SET_EXCEPTION_MASK_PARAMS *params,
+    NvU32 *control_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV83DE_CTRL_DEBUG_SET_EXCEPTION_MASK_PARAMS result;
+    NVOS54_PARAMETERS control;
+    nvidia_stack_t *sp = NULL;
+    nvidia_kernel_rmapi_ops_t ops;
+    NV_STATUS status;
+    NvU32 documented =
+        NV83DE_CTRL_DEBUG_SET_EXCEPTION_MASK_FATAL |
+        NV83DE_CTRL_DEBUG_SET_EXCEPTION_MASK_TRAP |
+        NV83DE_CTRL_DEBUG_SET_EXCEPTION_MASK_SINGLE_STEP |
+        NV83DE_CTRL_DEBUG_SET_EXCEPTION_MASK_INT |
+        NV83DE_CTRL_DEBUG_SET_EXCEPTION_MASK_CILP |
+        NV83DE_CTRL_DEBUG_SET_EXCEPTION_MASK_PREEMPTION_STARTED;
+    int rc;
+
+    if (control_status == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *control_status = 0xffffffffU;
+    if (session == NULL || params == NULL || h_client == 0 || h_debugger == 0 ||
+        !((params->exceptionMask & ~documented) == 0 ||
+          params->exceptionMask == NV83DE_CTRL_DEBUG_SET_EXCEPTION_MASK_ALL))
+        return NV_ERR_INVALID_ARGUMENT;
+
+    result = *params;
+    BUILD_BUG_ON(sizeof(result) != 4);
+    control = (NVOS54_PARAMETERS) {
+        .hClient = h_client,
+        .hObject = h_debugger,
+        .cmd = NV83DE_CTRL_CMD_DEBUG_SET_EXCEPTION_MASK,
+        .flags = NVOS54_FLAGS_NONE,
+        .params = KERNEL_POINTER_TO_NvP64(&result),
+        .paramsSize = sizeof(result),
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status != NV_OK)
+        goto done_pm;
+    rc = nv_kmem_cache_alloc_stack(&sp);
+    if (rc != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    ops = (nvidia_kernel_rmapi_ops_t) {
+        .op = NV04_CONTROL,
+        .params.control = control,
+    };
+    rm_kernel_rmapi_op(sp, &ops);
+    control = ops.params.control;
+    if (control.status == 0xffffffffU)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done_pm;
+    }
+    *control_status = (NvU32)control.status;
+    if (control.status == NV_OK)
+        *params = result;
+    status = NV_OK;
+
+done_pm:
+    if (sp != NULL)
+        nv_kmem_cache_free_stack(sp);
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_debugger_exception_mask_v1);
+
 
 
 
