 #include <linux/spinlock.h>
 #include <linux/slab.h>
 
+static DEFINE_MUTEX(hybrid580_sys_params_lock);
+
+/* The vendor ioctl and the private hybrid bridge share this set-once update.
+ * Its short critical section also prevents separate control sessions from
+ * racing the 64-bit field on 32-bit kernels. */
+static int hybrid580_set_sys_params(nv_linux_state_t *nvl, NvU64 memblock_size)
+{
+    int status = 0;
+
+    if (nvl == NULL)
+        return -EINVAL;
+
+    mutex_lock(&hybrid580_sys_params_lock);
+    if (nvl->numa_memblock_size == 0)
+    {
+        nvl->numa_memblock_size = memblock_size;
+    }
+    else if (nvl->numa_memblock_size != memblock_size)
+    {
+        status = -EBUSY;
+    }
+    mutex_unlock(&hybrid580_sys_params_lock);
+
+    return status;
+}
