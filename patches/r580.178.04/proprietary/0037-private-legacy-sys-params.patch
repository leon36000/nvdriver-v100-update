+/* Apply the exact NV_ESC_SYS_PARAMS control-device state transition without
+ * exposing an RM handle, user pointer, or the backend's public ioctl node. */
+int hybrid580_legacy_control_session_sys_params_v1(
+    struct hybrid580_control_session *session, NvU64 memblock_size)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_linux_state_t *nvl;
+    nv_state_t *nv;
+    nvidia_stack_t *sp = NULL;
+    NV_STATUS rm_status;
+    int status, rc;
+
+    if (session == NULL)
+        return -EINVAL;
+    rc = mutex_lock_interruptible(&session->lock);
+    if (rc != 0)
+        return rc;
+
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL || nvlfp->nvptr != &nv_ctl_device)
+    {
+        status = -EINVAL;
+        goto done;
+    }
+    nvl = nvlfp->nvptr;
+    nv = NV_STATE_PTR(nvl);
+    if ((nv->flags & NV_FLAG_CONTROL) == 0)
+    {
+        status = -EINVAL;
+        goto done;
+    }
+
+    status = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (status < 0)
+        goto done;
+    status = nv_kmem_cache_alloc_stack(&sp);
+    if (status != 0)
+        goto done_pm;
+
+    rm_status = nv_check_gpu_state(nv);
+    if (rm_status == NV_ERR_GPU_IS_LOST)
+        status = -EINVAL;
+    else
+        status = hybrid580_set_sys_params(nvl, memblock_size);
+
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_sys_params_v1);
+
