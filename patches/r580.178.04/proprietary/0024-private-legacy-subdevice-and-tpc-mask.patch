+NV_STATUS hybrid580_legacy_control_session_subdevice_alloc_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_device, NvHandle h_subdevice,
+    const NV2080_ALLOC_PARAMETERS *params, NvHandle *returned_subdevice,
+    NvU32 *rm_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV2080_ALLOC_PARAMETERS alloc_params;
+    NVOS64_PARAMETERS alloc;
+    nvidia_stack_t *sp = NULL;
+    nvidia_kernel_rmapi_ops_t ops;
+    NV_STATUS status;
+    int rc;
+
+    if (rm_status == NULL || returned_subdevice == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *rm_status = 0xffffffffU;
+    *returned_subdevice = 0;
+    if (session == NULL || params == NULL || h_root == 0 || h_device == 0 ||
+        h_subdevice == 0 || h_subdevice == h_root ||
+        h_subdevice == h_device || params->subDeviceId >= NV2080_MAX_SUBDEVICES)
+    {
+        *rm_status = NV_ERR_INVALID_ARGUMENT;
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    alloc_params = *params;
+    alloc = (NVOS64_PARAMETERS) {
+        .hRoot = h_root,
+        .hObjectParent = h_device,
+        .hObjectNew = h_subdevice,
+        .hClass = NV20_SUBDEVICE_0,
+        .pAllocParms = NV_PTR_TO_NvP64(&alloc_params),
+        .pRightsRequested = NvP64_NULL,
+        .paramsSize = sizeof(alloc_params),
+        .flags = NVOS64_FLAGS_NONE,
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    if (nv_kmem_cache_alloc_stack(&sp) != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        ops = (nvidia_kernel_rmapi_ops_t) { .op = NV04_ALLOC, .params.alloc = alloc };
+        rm_kernel_rmapi_op(sp, &ops);
+        alloc = ops.params.alloc;
+        *rm_status = alloc.status;
+        *returned_subdevice = alloc.hObjectNew;
+    }
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_subdevice_alloc_v1);
+
+
+NV_STATUS hybrid580_legacy_control_session_gr_tpc_mask_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_subdevice, NvU32 flags,
+    NV2080_CTRL_GR_GET_TPC_MASK_PARAMS *params, NvU32 *control_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV2080_CTRL_GR_GET_TPC_MASK_PARAMS result;
+    NVOS54_PARAMETERS control;
+    nvidia_stack_t *sp = NULL;
+    nvidia_kernel_rmapi_ops_t ops;
+    NV_STATUS status;
+    int rc;
+
+    if (control_status == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *control_status = NV_ERR_INVALID_ARGUMENT;
+    if (session == NULL || params == NULL || h_root == 0 || h_subdevice == 0 ||
+        flags != NVOS54_FLAGS_NONE)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    result = *params;
+    result.tpcMask = 0xffffffffU;
+    control = (NVOS54_PARAMETERS) {
+        .hClient = h_root,
+        .hObject = h_subdevice,
+        .cmd = NV2080_CTRL_CMD_GR_GET_TPC_MASK,
+        .flags = flags,
+        .params = KERNEL_POINTER_TO_NvP64(&result),
+        .paramsSize = sizeof(result),
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        rc = nv_kmem_cache_alloc_stack(&sp);
+        if (rc != 0)
+        {
+            status = NV_ERR_NO_MEMORY;
+            goto done_pm;
+        }
+        ops = (nvidia_kernel_rmapi_ops_t) {
+            .op = NV04_CONTROL,
+            .params.control = control,
+        };
+        rm_kernel_rmapi_op(sp, &ops);
+        control = ops.params.control;
+        *params = result;
+        *control_status = control.status;
+    }
+done_pm:
+    if (sp != NULL)
+        nv_kmem_cache_free_stack(sp);
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_gr_tpc_mask_v1);
