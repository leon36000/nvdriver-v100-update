+/* Snapshot the initialized PCI inventory while the backend minor table is
+ * locked. The caller owns the output buffer; no user pointer is retained.
+ */
+int hybrid580_legacy_gpu_inventory_v1(
+    struct hybrid580_gpu_backend_record_v1 *records,
+    NvU32 capacity, NvU32 *count)
+{
+    nv_linux_state_t *nvl;
+    nv_state_t *nv;
+    NvU32 required = 0, i = 0;
+    int rc = 0;
+
+    if (count == NULL)
+        return -EINVAL;
+    *count = 0;
+    if (capacity > HYBRID580_GPU_MAX_BACKEND_DEVICES ||
+        (capacity != 0 && records == NULL))
+        return -EINVAL;
+
+    LOCK_NV_LINUX_DEVICES();
+    for (nvl = nv_linux_devices; nvl != NULL; nvl = nvl->next)
+    {
+        nv = NV_STATE_PTR(nvl);
+        if (nvl->pci_dev == NULL || (nv->flags & NV_FLAG_EXCLUDE) != 0)
+            continue;
+        ++required;
+    }
+    if (required > HYBRID580_GPU_MAX_BACKEND_DEVICES)
+    {
+        rc = -E2BIG;
+        goto out;
+    }
+    *count = required;
+    if (capacity < required)
+    {
+        rc = -ENOSPC;
+        goto out;
+    }
+
+    for (nvl = nv_linux_devices; nvl != NULL; nvl = nvl->next)
+    {
+        struct hybrid580_gpu_backend_record_v1 *record;
+        nv = NV_STATE_PTR(nvl);
+        if (nvl->pci_dev == NULL || (nv->flags & NV_FLAG_EXCLUDE) != 0)
+            continue;
+        if (nvl->minor_num > NV_MINOR_DEVICE_NUMBER_REGULAR_MAX)
+        {
+            rc = -EIO;
+            goto clear_output;
+        }
+        record = &records[i];
+        memset(record, 0, sizeof(*record));
+        if (strscpy(record->bdf, pci_name(nvl->pci_dev),
+                    sizeof(record->bdf)) < 0)
+        {
+            rc = -EIO;
+            goto clear_output;
+        }
+        record->backend_minor = nvl->minor_num;
+        record->backend_gpu_id = nv->gpu_id;
+        record->domain = pci_domain_nr(nvl->pci_dev->bus);
+        record->bus = nvl->pci_dev->bus->number;
+        record->slot = PCI_SLOT(nvl->pci_dev->devfn);
+        record->function = PCI_FUNC(nvl->pci_dev->devfn);
+        record->vendor_id = nvl->pci_dev->vendor;
+        record->device_id = nvl->pci_dev->device;
+        ++i;
+    }
+    goto out;
+
+clear_output:
+    memset(records, 0, capacity * sizeof(*records));
+    *count = 0;
+out:
+    UNLOCK_NV_LINUX_DEVICES();
+    return rc;
+}
+EXPORT_SYMBOL(hybrid580_legacy_gpu_inventory_v1);
