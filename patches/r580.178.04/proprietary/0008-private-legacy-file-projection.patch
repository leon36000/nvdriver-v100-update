+/* SPDX-License-Identifier: MIT */
+#ifndef HYBRID580_FILE_PROJECTION_H
+#define HYBRID580_FILE_PROJECTION_H
+
+#include <linux/types.h>
+#include <linux/module.h>
+#include <linux/fs.h>
+
+#define HYBRID580_FILE_PROJECTION_ABI_V1 1U
+
+/* Private experimental kernel API, not a CUDA or userspace ABI.
+ * Register/unregister in process context using the same static ops address.
+ * The owner must own frontend_fops, register its own provider, and unregister
+ * before module teardown; no permanent module pin is taken by registration.
+ * Registration copies ops; changing the caller's object has no effect.
+ *
+ * Lock order: files->file_lock -> projection registry read lock -> atomic
+ * frontend mapping access. get_backing_file runs with IRQs disabled and may
+ * run under iterate_fd files->file_lock. It MUST NOT sleep, call RM, fget,
+ * acquire a files_struct lock, register/unregister, or recurse into projection.
+ * It must run in bounded O(1) time. Return NULL or exactly one get_file reference
+ * to a fully opened file of this private backend. Never return ERR_PTR.
+ * ctl is true for control-file lookup and false for a GPU-file lookup.
+ * The frontend must keep the backing file alive while it is published and
+ * serialize its pointer replacement so get_file cannot race a final put.
+ * Taking a file reference does not isolate concurrent userspace ioctls.
+ */
+struct hybrid580_file_projection_ops_v1 {
+    u32 abi_version;
+    u32 struct_size;
+    struct module *owner;
+    const struct file_operations *frontend_fops;
+    struct file *(*get_backing_file)(struct file *front, bool ctl);
+};
+
+int hybrid580_legacy_register_file_projection_v1(
+    const struct hybrid580_file_projection_ops_v1 *ops);
+int hybrid580_legacy_unregister_file_projection_v1(
+    const struct hybrid580_file_projection_ops_v1 *ops);
+
+#endif
