+/* A provider owns its frontend fops and unregisters before module teardown.
+ * Only the immutable copy is read by callbacks. No permanent module reference:
+ * taking one here would prevent the provider's module_exit from unregistering.
+ */
+struct hybrid580_file_projection_provider {
+    struct hybrid580_file_projection_ops_v1 ops;
+    const struct hybrid580_file_projection_ops_v1 *key;
+};
+static DEFINE_RWLOCK(hybrid580_file_projection_lock);
+static struct hybrid580_file_projection_provider *hybrid580_file_projection;
+
+int hybrid580_legacy_register_file_projection_v1(
+    const struct hybrid580_file_projection_ops_v1 *ops)
+{
+    struct hybrid580_file_projection_provider *provider;
+    int rc = 0;
+    unsigned long flags;
+
+    if (ops == NULL || ops->abi_version != HYBRID580_FILE_PROJECTION_ABI_V1 ||
+        ops->struct_size != sizeof(*ops) || ops->owner == NULL ||
+        ops->frontend_fops == NULL || ops->frontend_fops == &nvidia_fops ||
+        ops->frontend_fops->owner != ops->owner || ops->get_backing_file == NULL)
+        return -EINVAL;
+
+    provider = kzalloc(sizeof(*provider), GFP_KERNEL);
+    if (provider == NULL)
+        return -ENOMEM;
+    provider->ops = *ops;
+    provider->key = ops;
+
+    write_lock_irqsave(&hybrid580_file_projection_lock, flags);
+    if (hybrid580_file_projection != NULL)
+        rc = -EBUSY;
+    else
+        hybrid580_file_projection = provider;
+    write_unlock_irqrestore(&hybrid580_file_projection_lock, flags);
+    if (rc != 0)
+        kfree(provider);
+    return rc;
+}
+EXPORT_SYMBOL(hybrid580_legacy_register_file_projection_v1);
+
+int hybrid580_legacy_unregister_file_projection_v1(
+    const struct hybrid580_file_projection_ops_v1 *ops)
+{
+    struct hybrid580_file_projection_provider *provider;
+    unsigned long flags;
+
+    write_lock_irqsave(&hybrid580_file_projection_lock, flags);
+    provider = hybrid580_file_projection;
+    if (provider == NULL || provider->key != ops)
+    {
+        write_unlock_irqrestore(&hybrid580_file_projection_lock, flags);
+        return -ENOENT;
+    }
+    hybrid580_file_projection = NULL;
+    /* Acquiring the write lock waited for every active callback reader. */
+    write_unlock_irqrestore(&hybrid580_file_projection_lock, flags);
+    kfree(provider);
+    return 0;
+}
+EXPORT_SYMBOL(hybrid580_legacy_unregister_file_projection_v1);
+
+/* Lock order: files->file_lock -> projection read lock -> atomic frontend
+ * mapping access. The callback cannot take the files lock or a sleeping lock.
+ * The returned file reference outlives both frontend and provider lifetime.
+ */
+static struct file *hybrid580_legacy_project_file(struct file *front, NvBool ctl)
+{
+    struct hybrid580_file_projection_provider *provider;
+    struct module *owner = NULL;
+    struct file *back = NULL;
+    unsigned long flags;
+
+    if (front == NULL || front->f_op == &nvidia_fops)
+        return NULL;
+    read_lock_irqsave(&hybrid580_file_projection_lock, flags);
+    provider = hybrid580_file_projection;
+    if (provider != NULL && front->f_op == provider->ops.frontend_fops &&
+        try_module_get(provider->ops.owner))
+    {
+        owner = provider->ops.owner;
+        back = provider->ops.get_backing_file(front, ctl);
+    }
+    read_unlock_irqrestore(&hybrid580_file_projection_lock, flags);
+    if (owner != NULL)
+        module_put(owner);
+    if (IS_ERR(back))
+        return NULL;
+    if (back != NULL && (back == front || back->f_op != &nvidia_fops))
+    {
+        fput(back);
+        back = NULL;
+    }
+    return back;
+}
+
+/* Does not sleep: also used while iterate_fd holds the files lock.
+ * ctl < 0 accepts either valid backend kind for direct-file state matching.
+ */
+static nv_linux_file_private_t *hybrid580_legacy_backend_file(
+    struct file *filp, int ctl)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_linux_state_t *nvl;
+    struct inode *inode;
+    dev_t rdev;
+    unsigned int minor;
+
+    if (filp == NULL || filp->f_op != &nvidia_fops ||
+        hybrid_chrdev_base == 0 || (inode = NV_FILE_INODE(filp)) == NULL)
+        return NULL;
+    rdev = inode->i_rdev;
+    if (!S_ISCHR(inode->i_mode) ||
+        MAJOR(rdev) != MAJOR(hybrid_chrdev_base))
+        return NULL;
+    minor = MINOR(rdev);
+    nvlfp = NV_GET_LINUX_FILE_PRIVATE(filp);
+    if (nvlfp == NULL || (nvl = READ_ONCE(nvlfp->nvptr)) == NULL)
+        return NULL;
+    if (minor == NV_MINOR_DEVICE_NUMBER_CONTROL_DEVICE)
+    {
+        if (ctl == 0 || nvl != &nv_ctl_device ||
+            ((NV_STATE_PTR(nvl))->flags & (NV_FLAG_OPEN | NV_FLAG_CONTROL)) !=
+                (NV_FLAG_OPEN | NV_FLAG_CONTROL))
+            return NULL;
+    }
+    else if (ctl > 0 || minor > NV_MINOR_DEVICE_NUMBER_REGULAR_MAX ||
+             nvl == &nv_ctl_device ||
+             READ_ONCE(nv_linux_minor_num_table[minor]) != nvl)
+        return NULL;
+    return nvlfp;
+}
