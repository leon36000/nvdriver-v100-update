--- a/nvidia/nv.c
+++ b/nvidia/nv.c
@@ -5182,6 +5182,87 @@
 EXPORT_SYMBOL(hybrid580_legacy_control_session_channel_group_alloc_v1);
 
 
+NV_STATUS hybrid580_legacy_control_session_context_share_alloc_v1(
+    struct hybrid580_control_session *session, NvHandle h_root,
+    NvHandle h_group, NvHandle h_context_share,
+    NV_CTXSHARE_ALLOCATION_PARAMETERS *params,
+    NvHandle *returned_context_share, NvU32 *rm_status)
+{
+    nv_linux_file_private_t *nvlfp;
+    nv_state_t *nv;
+    NV_CTXSHARE_ALLOCATION_PARAMETERS alloc_params;
+    NVOS64_PARAMETERS alloc;
+    nvidia_stack_t *sp = NULL;
+    NV_STATUS status;
+    int rc;
+
+    if (rm_status == NULL || returned_context_share == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *rm_status = 0xffffffffU;
+    *returned_context_share = 0;
+    if (session == NULL || params == NULL || h_root == 0 || h_group == 0 ||
+        h_context_share == 0 || h_context_share == h_root ||
+        h_context_share == h_group || params->hVASpace == 0 ||
+        (params->flags & ~0x3U) != 0 ||
+        (params->flags == NV_CTXSHARE_ALLOCATION_FLAGS_SUBCONTEXT_SPECIFIED ?
+            (params->subctxId & 0x80000000U) != 0 : params->subctxId != 0))
+    {
+        *rm_status = NV_ERR_INVALID_ARGUMENT;
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    alloc_params = *params;
+    alloc = (NVOS64_PARAMETERS) {
+        .hRoot = h_root,
+        .hObjectParent = h_group,
+        .hObjectNew = h_context_share,
+        .hClass = FERMI_CONTEXT_SHARE_A,
+        .pAllocParms = NV_PTR_TO_NvP64(&alloc_params),
+        .pRightsRequested = NvP64_NULL,
+        .paramsSize = sizeof(alloc_params),
+        .flags = NVOS64_FLAGS_NONE,
+        .status = 0xffffffffU,
+    };
+
+    if (mutex_lock_interruptible(&session->lock) != 0)
+        return NV_ERR_OPERATING_SYSTEM;
+    nvlfp = hybrid580_legacy_backend_file(session->file, 1);
+    if (nvlfp == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+    rc = nv_down_read_interruptible(&nv_system_pm_lock);
+    if (rc < 0)
+    {
+        status = NV_ERR_OPERATING_SYSTEM;
+        goto done;
+    }
+    if (nv_kmem_cache_alloc_stack(&sp) != 0)
+    {
+        status = NV_ERR_NO_MEMORY;
+        goto done_pm;
+    }
+    nv = NV_STATE_PTR(nvlfp->nvptr);
+    status = nv_check_gpu_state(nv);
+    if (status == NV_OK)
+    {
+        status = rm_ioctl(sp, nv, &nvlfp->nvfp, NV_ESC_RM_ALLOC,
+                          &alloc, sizeof(alloc));
+        *params = alloc_params;
+        *rm_status = alloc.status;
+        *returned_context_share = alloc.hObjectNew;
+    }
+    nv_kmem_cache_free_stack(sp);
+done_pm:
+    up_read(&nv_system_pm_lock);
+done:
+    mutex_unlock(&session->lock);
+    return status;
+}
+EXPORT_SYMBOL(hybrid580_legacy_control_session_context_share_alloc_v1);
