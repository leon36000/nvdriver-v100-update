+/* The hybrid owner must distinguish a real UVM transition from the legacy
+ * no-callback success used by nv_uvm_suspend()/nv_uvm_resume(). */
+NV_STATUS hybrid580_open_nv_uvm_suspend_registered_v1(void)
+{
+    NV_STATUS status = NV_ERR_NOT_SUPPORTED;
+    struct UvmOpsUvmEvents *events;
+
+    down(&g_pNvUvmEventsLock);
+    events = getUvmEvents();
+    if (events != NULL && events->suspend != NULL)
+        status = events->suspend();
+    up(&g_pNvUvmEventsLock);
+
+    return status;
+}
+
+NV_STATUS hybrid580_open_nv_uvm_resume_registered_v1(void)
+{
+    NV_STATUS status = NV_ERR_NOT_SUPPORTED;
+    struct UvmOpsUvmEvents *events;
+
+    down(&g_pNvUvmEventsLock);
+    events = getUvmEvents();
+    if (events != NULL && events->resume != NULL)
+        status = events->resume();
+    up(&g_pNvUvmEventsLock);
+
+    return status;
+}
