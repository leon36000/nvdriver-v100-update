  "findings": [
    {
      "finding": "The DKMS package preinst can invoke /usr/bin/nvidia-uninstall -s when present, and the DKMS package postinst/prerm/postrm invoke DKMS and initramfs actions.",
      "implication": "A package swap may remove an external .run installation, rebuild/remove NVIDIA DKMS modules, and update initramfs; those hooks were not executed."
    },
    {
      "finding": "The kernel-common package postinst/postrm update initramfs and modify hybrid-graphics module configuration; its service hooks update NVIDIA suspend/resume/hibernate units.",
      "implication": "Package configuration/removal changes boot and systemd state and requires a prepared, host-specific recovery plan."
    },
    {
      "finding": "The compute-utils package preinst/prerm can stop nvidia-persistenced; the kernel-module package hooks run depmod.",
      "implication": "Even a matched stack replacement can disrupt live driver services; no such operation is authorized or performed."
    }
  ],
