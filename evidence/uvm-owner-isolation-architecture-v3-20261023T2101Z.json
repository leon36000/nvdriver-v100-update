{
  "architecture_comparison": {
    "decision_reason": "It keeps the existing single UVM control plane and avoids multiplying the user-space ioctl routing surface. The first discriminating test is whether the documented MemoryAllocSys/DupAllocation path can map one semaphore page from one provider's VA space into the other provider's VA space. The open contract and proprietary RM behavior do not yet prove that cross-provider duplication is supported; if it fails, revisit isolated UVM ownership.",
    "first_experiment": "shared_system_memory_mapping",
    "isolated_uvm_owners": {
      "classification": "larger_kernel_and_userspace_integration",
      "not_proven_impossible": true,
      "required_changes": [
        "distinct module and user-visible device identities for each UVM owner",
        "independent callback/session routing instead of the current single registry",
        "one-process CUDA/IOCTL routing to the correct UVM fd and backend",
        "explicit semantics for cross-owner managed memory and peer operations"
      ]
    },
    "shared_system_memory_mapping": {
      "classification": "narrowest_first_experiment",
      "preserves_one_uvm_control_plane": true,
      "required_contract": "map the same system-memory semaphore allocation from one RM provider's VA space into the other provider's VA space with coherent cross-GPU use",
      "unproven_requirements": [
        "provider-local GPU mapping of the same system-memory backing",
        "DMA/IOMMU address validity and lifetime for both devices",
        "CPU/GPU visibility, semaphore ordering, invalidation and teardown"
      ]
    }
  },
  "bridge_registration": {
    "callback_model": "one frontend registry fans out one UVM callback table to both RMs",
    "multi_uvm_registration": "rejected_while_registration_active",
    "session_model": "one logical UVM session is paired across Open and legacy RMs"
  },
